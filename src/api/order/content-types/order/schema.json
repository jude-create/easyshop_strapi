{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firebaseUid": {
      "type": "string",
      "required": true
    },
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Delivered",
        "Processing",
        "Shipped",
        "Cancelled"
      ],
      "default": "Processing",
      "required": true
    },
    "items": {
      "type": "json",
      "required": true
    },
    "subtotal": {
      "type": "decimal",
      "required": true
    },
    "delivery": {
      "type": "decimal",
      "required": true
    },
    "paymentMethod": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    }
  }
}
