HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=your-app-keys-here
API_TOKEN_SALT=your-api-token-salt-here
ADMIN_JWT_SECRET=your-admin-jwt-secret-here
TRANSFER_TOKEN_SALT=your-transfer-token-salt-here
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Optional local-only Firebase Admin credential path
# Do not use a Windows file path in Strapi Cloud.
GOOGLE_APPLICATION_CREDENTIALS=

# Production-safe Firebase Admin credentials for Strapi Cloud
# Paste the full service account JSON as a single-line escaped string.
FIREBASE_SERVICE_ACCOUNT_JSON=
